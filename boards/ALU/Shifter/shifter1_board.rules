
(rules PCB shifter1_board.dsn
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout on)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 1)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.8)
      (against_preferred_direction_trace_costs 4.8)
    )
    (layer_rule In1.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.2)
    )
    (layer_rule In2.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 4.0)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.8)
      (against_preferred_direction_trace_costs 4.0)
    )
  )
  (rule
    (width 100.0)
    (clearance 100.0)
    (clearance 50.0 (type smd_to_turn_gap))
    (clearance 25.0 (type smd))
    (clearance 100.0 (type "kicad_default"))
    (clearance 100.0 (type Power,Default))
  )
  (padstack "Via[0-3]_400:300_um"
    (shape
      (circle F.Cu 400.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 400.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 400.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 400.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-3]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-3]_400:300_um" "Via[0-3]_400:300_um" default
  )
  (via 
    "Via[0-3]_600:300_um" "Via[0-3]_600:300_um" default
  )
  (via 
    "Via[0-3]_400:300_um-kicad_default" "Via[0-3]_400:300_um" "kicad_default"
  )
  (via 
    "Via[0-3]_600:300_um-kicad_default" "Via[0-3]_600:300_um" "kicad_default"
  )
  (via 
    "Via[0-3]_400:300_um-Power,Default" "Via[0-3]_400:300_um" Power,Default
  )
  (via 
    "Via[0-3]_600:300_um-Power,Default" "Via[0-3]_600:300_um" Power,Default
  )
  (via_rule
    default "Via[0-3]_400:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-3]_400:300_um-kicad_default"
  )
  (via_rule
    Power,Default "Via[0-3]_600:300_um-Power,Default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 100.0)
    )
    (circuit 
      (use_layer F.Cu In1.Cu In2.Cu B.Cu)
    )
  )
  (class "kicad_default"
    F.23 A.27 A.4 A.7 F.31 A.30 F.15 A.31
    F.25 F.19 A.9 F.13 A.18 F.21 F.8 A.0
    F.11 A.1 A.24 F.2 A.5 F.30 A.29 F.10
    B.1 F.0 F.6 A.6 F.9 A.25 A.3 F.1
    F.7 A.2 A.28 F.16 A.15 B.0 F.22 F.12
    F.29 F.3 F.18 F.27 A.14 A.23 A.26 A.19
    A.8 F.14 A.10 A.16 A.13 F.20 A.21 F.4
    A.20 F.28 F.17 A.17 A.12 F.26 A.11 F.5
    A0 F.24 A.22 "sh1._069_" "sh1._067_" "sh1._068_" "sh1._051_" "sh1._052_"
    "sh1._053_" "sh1._054_" "sh1._055_" "sh1._057_" "sh1._056_" "sh1._058_" "sh1._059_" "sh1._060_"
    "sh1._061_" "sh1._062_" "sh1._063_" "sh1._064_" "sh1._065_" "sh1._035_" "sh1._066_" "sh1._036_"
    "sh1._037_" "sh1._038_" "sh1._039_" "sh1._040_" "sh1._041_" "sh1._042_" "sh1._043_" "sh1._044_"
    "sh1._046_" "sh1._045_" "sh1._047_" "sh1._048_" "sh1._049_" "sh1._050_" "sh1._073_.0" "sh1._073_.10"
    "sh1._073_.11" "sh1._073_.12" "sh1._073_.13" "sh1._073_.14" "sh1._073_.15" "sh1._073_.16" "sh1._073_.17" "sh1._073_.18"
    "sh1._073_.19" "sh1._073_.1" "sh1._073_.20" "sh1._073_.21" "sh1._073_.22" "sh1._073_.23" "sh1._073_.24" "sh1._073_.25"
    "sh1._073_.26" "sh1._073_.27" "sh1._073_.28" "sh1._073_.29" "sh1._073_.2" "sh1._073_.30" "sh1._073_.31" "sh1._073_.3"
    "sh1._073_.4" "sh1._073_.5" "sh1._073_.6" "sh1._073_.7" "sh1._073_.8" "sh1._073_.9" pins.72 pins.71
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 100.0)
    )
    (circuit 
      (use_layer F.Cu In1.Cu In2.Cu B.Cu)
    )
  )
  (class Power,Default
    GND VDD
    (clearance_class Power,Default)
    (via_rule Power,Default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu In1.Cu In2.Cu B.Cu)
    )
  )
)