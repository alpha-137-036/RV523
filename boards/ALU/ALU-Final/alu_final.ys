read_verilog -sv ../alu_typedefs.sv alu_final.sv
read_verilog -lib ../../../lib/RV523_blackbox.v

hierarchy -top alu_final
flatten

#check obvious problems in the current design 8combinatorila loops, conflicts, etc.
check;

#opt_clean with less verbose
clean;


# translate processes to netlists
proc;

#extract and optimize finite state machines
fsm; opt;

#translate memories to basic cells
memory; opt;


opt -full

opt_reduce
opt_expr

techmap;
dfflibmap -liberty ../../../lib/RV523.lib
abc -script alu_final.abc -liberty ../../../lib/RV523.lib

stat -liberty ../../../lib/RV523.lib

write_json alu_final.netlist.json
write_verilog alu_final.netlist.v

