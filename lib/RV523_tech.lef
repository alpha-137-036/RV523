VERSION 5.7 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;

UNITS
  DATABASE MICRONS 1000 ;
END UNITS

SITE CoreSite
  CLASS CORE ;
  SIZE 1 BY 4 ;
END CoreSite

MANUFACTURINGGRID 0.05 ;

LAYER active
  TYPE MASTERSLICE ;
END active

LAYER M1
    TYPE ROUTING ;
    DIRECTION HORIZONTAL ;
    SPACING 0.1 ;
    WIDTH 0.1 ;
    PITCH 0.05 ;
END M1
LAYER CUT1
  TYPE CUT ;
  SPACING 0.1 ;
  WIDTH 0.1 ;
END CUT1
LAYER M2
    TYPE ROUTING ;
    DIRECTION VERTICAL ;
    SPACING 0.1 ;
    WIDTH 0.1 ;
    PITCH 0.05 ;
END M2
LAYER CUT2
  TYPE CUT ;
  SPACING 0.1 ;
  WIDTH 0.05 ;
END CUT2
LAYER M3
    TYPE ROUTING ;
    DIRECTION HORIZONTAL ;
    SPACING 0.1 ;
    WIDTH 0.1 ;
    PITCH 0.05 ;
END M3
LAYER CUT3
  TYPE CUT ;
  SPACING 0.1 ;
  WIDTH 0.1 ;
END CUT3
LAYER M4
    TYPE ROUTING ;
    DIRECTION VERTICAL ;
    SPACING 0.1 ;
    WIDTH 0.1 ;
    PITCH 0.05 ;
END M4

VIA VIA12 DEFAULT
  LAYER M1 ;
    RECT -0.2 -0.2 0.2 0.2 ;
  LAYER CUT1 ;
    RECT -0.2 -0.2 0.2 0.2 ;
  LAYER M2 ;
    RECT -0.2 -0.2 0.2 0.2 ;
END VIA12

VIA VIA23 DEFAULT
  LAYER M2 ;
    RECT -0.2 -0.2 0.2 0.2 ;
  LAYER CUT2 ;
    RECT -0.2 -0.2 0.2 0.2 ;
  LAYER M3 ;
    RECT -0.2 -0.2 0.2 0.2 ;
END VIA23

VIA VIA34 DEFAULT
  LAYER M3 ;
    RECT -0.2 -0.2 0.2 0.2 ;
  LAYER CUT3 ;
    RECT -0.2 -0.2 0.2 0.2 ;
  LAYER M4 ;
    RECT -0.2 -0.2 0.2 0.2 ;
END VIA34


END LIBRARY