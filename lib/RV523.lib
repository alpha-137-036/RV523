library (RV523) {
  technology : cmos;
  delay_model : table_lookup;
  bus_naming_style : "%s-%d";

  /* Units */
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1uA";
  pulling_resistance_unit : "1kOhm";
  leakage_power_unit : "1nW";
  capacitive_load_unit(1, pf);

  /* Slew characteristics */
