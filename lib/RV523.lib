    pg_pin (VDD) {
      voltage_name : VDD;
      pg_type : primary_power;
    }
    pg_pin (VSS) {
      voltage_name : VSS;
      pg_type : primary_ground;
    }

    ff(IQ, IQN) {
        clocked_on : "CK";
        next_state : "D";
    }
    
    pin(D) {
        direction : input;
        capacitance : 107.4854;
        
        timing() {
            related_pin : "CK";
            timing_type : setup_rising;
            rise_constraint(setup_5x5) {
                input_1(10.0,20.0,40.0,100.0,150.0);
                input_2(10.0,20.0,40.0,100.0,150.0);
