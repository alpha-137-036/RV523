library (RV523) {
  technology : cmos;
  delay_model : table_lookup;
  bus_naming_style : "%s-%d";

  /* Units */
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1uA";
  pulling_resistance_unit : "1kOhm";
  leakage_power_unit : "1nW";
  capacitive_load_unit(1, pf);

  /* Slew characteristics */
  slew_upper_threshold_pct_rise : 80;
  slew_lower_threshold_pct_rise : 20;
  slew_upper_threshold_pct_fall : 80;
  slew_lower_threshold_pct_fall : 20;
  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;

  /* Operating Conditions */
  nom_process : 1;
  nom_voltage : 3.3;
  nom_temperature : 25;

  /* Table Templates */
  lu_table_template (delay_template_5x7) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("10, 20, 40, 100, 150");
    index_2 ("5, 10, 20, 40, 60, 80, 100");
  }
  /* Table Templates */
  lu_table_template (delay_template_5x9) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("10, 20, 40, 100, 150");
    index_2 ("5, 10, 20, 40, 60, 80, 100, 150, 200");
  }

  lu_table_template (setup_5x5) {
	variable_1 : constrained_pin_transition;
	variable_2 : related_pin_transition;
    index_1 ("10, 20, 40, 100, 150");
    index_2 ("10, 20, 40, 100, 150");
  }
  lu_table_template (hold_5x5) {
	variable_1 : constrained_pin_transition;
	variable_2 : related_pin_transition;
    index_1 ("10, 20, 40, 100, 150");
    index_2 ("10, 20, 40, 100, 150");
  }

  /* DECAP */
  cell (DECAP) {
    area : 2;
  }

  cell(PULSED_DFF) {
